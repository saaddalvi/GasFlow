generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum PartyType {
  shop
  customer
  refiller
  supplier

  @@map("party_type")
}

model Party {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          PartyType
  /// Case-insensitive, so that lists sort by name whatever its capitals.
  name          String    @db.Citext
  /// A short code. Only the shop has none.
  abbreviation  String?
  mobile        String?
  contactPerson String?   @map("contact_person")
  address       String?
  notes         String?
  active        Boolean   @default(true)
  billsFrom     Bill[]    @relation("bills_from")
  billsTo       Bill[]    @relation("bills_to")

  // The agency has exactly one shop.
  @@unique([type], map: "parties_one_shop", where: raw("type = 'shop'"))
  @@map("parties")
}

model Gas {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Case-insensitive, so that no two gases differ only in capitals.
  name      String     @unique @db.Citext
  sortOrder Int        @map("sort_order")
  /// False once an admin retires the gas. A gas is never deleted.
  active    Boolean    @default(true)
  billLines BillLine[]

  @@map("gases")
}

/// What was decided once, when the agency set the app up. It has one row at
/// most, which a check in the migration keeps to the id 1.
model Setup {
  id        Int      @id @default(1)
  /// The date from which the records begin. No bill is dated earlier.
  startDate DateTime @map("start_date") @db.Date

  @@map("setup")
}

/// A staff member who has signed in. The row outlives their account, so that
/// bills can go on showing who entered and cancelled them. The admin role is not
/// stored here; the identity provider holds it.
model Staff {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId     String         @unique @map("identity_id")
  displayName    String         @map("display_name")
  billsEntered   Bill[]         @relation("bills_entered")
  billsCancelled Bill[]         @relation("bills_cancelled")
  billsCorrected BillRevision[]

  @@map("staff")
}

model Vehicle {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Case-insensitive, so that lists sort by plate whatever its capitals.
  plate  String  @db.Citext
  label  String?
  active Boolean @default(true)
  bills  Bill[]

  @@map("vehicles")
}

enum BillType {
  opening_stock
  dispatch
  send_to_refiller
  return_from_refiller
  return_from_customer
  add_cylinders
  write_off

  @@map("bill_type")
}

enum BillStatus {
  posted
  cancelled

  @@map("bill_status")
}

enum CancelReason {
  data_entry_error
  duplicate_entry
  customer_rejected
  wrong_cylinder_loaded
  bill_voided
  other

  @@map("cancel_reason")
}

/// Why cylinders left the business for good.
enum WriteOffReason {
  scrapped
  lost

  @@map("write_off_reason")
}

enum FillState {
  filled
  empty
  defective

  @@map("fill_state")
}

/// The kind of paper a bill was written on. Numbers are unique within one.
enum PaperKind {
  bill
  cash_memo

  @@map("paper_kind")
}

/// A dated record of cylinders moving between parties, or joining or leaving the
/// business. Only the bill ledger changes bills. Only posted ones count.
model Bill {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           BillType
  /// Case-insensitive, so that no two typed numbers differ only in capitals.
  number         String          @db.Citext
  /// Set on bills numbered from the agency's own paper, and only on those.
  paperKind      PaperKind?      @map("paper_kind")
  date           DateTime        @db.Date
  status         BillStatus      @default(posted)
  /// Whom the cylinders leave. Null when they join the business.
  fromPartyId    String?         @map("from_party_id") @db.Uuid
  /// Who receives them. Null when they leave the business.
  toPartyId      String?         @map("to_party_id") @db.Uuid
  vehicleId      String?         @map("vehicle_id") @db.Uuid
  notes          String?
  /// The paper return slip's number, noted on a return from a customer. Unlike
  /// the bill number, it need not be unique.
  slipNumber     String?         @map("slip_number")
  /// Set on write-offs, and only on those.
  writeOffReason WriteOffReason? @map("write_off_reason")
  enteredById    String          @map("entered_by_id") @db.Uuid
  enteredAt      DateTime        @map("entered_at") @db.Timestamptz(3)
  fromParty      Party?          @relation("bills_from", fields: [fromPartyId], references: [id], onDelete: Restrict)
  toParty        Party?          @relation("bills_to", fields: [toPartyId], references: [id], onDelete: Restrict)
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  /// These four say who cancelled the bill, when and why. A check in the
  /// migration requires all but the notes on a cancelled bill, and allows none of
  /// the four on a posted one.
  cancelReason   CancelReason?   @map("cancel_reason")
  cancelNotes    String?         @map("cancel_notes")
  cancelledById  String?         @map("cancelled_by_id") @db.Uuid
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  enteredBy      Staff           @relation("bills_entered", fields: [enteredById], references: [id])
  cancelledBy    Staff?          @relation("bills_cancelled", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines          BillLine[]
  revisions      BillRevision[]

  // A party has one opening stock. A cancelled one makes way for another.
  @@unique([toPartyId], map: "bills_one_opening_stock_per_party", where: raw("type = 'opening_stock' AND status = 'posted'"))
  // No two bills on one paper kind share a number, in any year. A cancelled one
  // frees its number.
  @@unique([paperKind, number], map: "bills_one_number_per_paper_kind", where: raw("status = 'posted'"))
  // A return from a refiller is numbered by the refiller's slip, whose number no
  // other posted return from that refiller may have.
  @@unique([fromPartyId, number], map: "bills_one_slip_number_per_refiller", where: raw("type = 'return_from_refiller' AND status = 'posted'"))
  @@index([date, enteredAt])
  @@index([fromPartyId])
  @@index([toPartyId])
  @@map("bills")
}

model BillLine {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId    String       @map("bill_id") @db.Uuid
  /// The line's place on its bill, counted from 1.
  lineNo    Int          @map("line_no")
  gasId     String       @map("gas_id") @db.Uuid
  fillState FillState    @map("fill_state")
  /// More than zero, by a check in the migration.
  quantity  Int
  bill      Bill         @relation(fields: [billId], references: [id])
  gas       Gas          @relation(fields: [gasId], references: [id])
  /// On a return or a customer's write-off, what its quantity is matched to. Any
  /// of a return's quantity that none of these covers is unmatched.
  clears    Allocation[] @relation("clearing_line")
  /// On a dispatch bill or opening stock, what has been matched to it.
  clearedBy Allocation[] @relation("cleared_line")

  @@unique([billId, lineNo])
  @@map("bill_lines")
}

/// A version of a bill that a correction replaced, kept so that it can still be
/// read. No figure counts it.
model BillRevision {
  billId       String   @map("bill_id") @db.Uuid
  /// Which version of the bill this was, counted from 1, the one first entered.
  version      Int
  /// What the bill said, as the API reported it then, with the names of that time.
  content      Json
  /// Who made the correction that replaced this version, and when.
  replacedById String   @map("replaced_by_id") @db.Uuid
  replacedAt   DateTime @map("replaced_at") @db.Timestamptz(3)
  bill         Bill     @relation(fields: [billId], references: [id], onDelete: Restrict)
  replacedBy   Staff    @relation(fields: [replacedById], references: [id], onDelete: Restrict)

  @@id([billId, version])
  @@map("bill_revisions")
}

/// The part of a return or customer write-off that is matched to a line of a
/// dispatch bill or opening stock for the same customer and gas, dated no later
/// than it. It counts only while that return or write-off is posted.
model Allocation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The line of the return or write-off.
  clearingLineId String   @map("clearing_line_id") @db.Uuid
  /// The line whose pending cylinders it clears.
  clearedLineId  String   @map("cleared_line_id") @db.Uuid
  /// More than zero, by a check in the migration.
  quantity       Int
  clearingLine   BillLine @relation("clearing_line", fields: [clearingLineId], references: [id])
  clearedLine    BillLine @relation("cleared_line", fields: [clearedLineId], references: [id])

  @@unique([clearingLineId, clearedLineId])
  @@index([clearedLineId])
  @@map("allocations")
}

/// The last number issued to bills of one prefix and date.
model BillNumberCounter {
  prefix String
  date   DateTime @db.Date
  last   Int

  @@id([prefix, date])
  @@map("bill_number_counters")
}
