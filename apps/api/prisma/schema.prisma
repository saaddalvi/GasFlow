generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum PartyType {
  shop
  customer
  refiller
  supplier

  @@map("party_type")
}

model Party {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          PartyType
  /// Case-insensitive, so that lists sort by name whatever its capitals.
  name          String    @db.Citext
  /// A short code. Only the shop has none.
  abbreviation  String?
  mobile        String?
  contactPerson String?   @map("contact_person")
  address       String?
  notes         String?
  active        Boolean   @default(true)

  // The agency has exactly one shop.
  @@unique([type], map: "parties_one_shop", where: raw("type = 'shop'"))
  @@map("parties")
}

model Gas {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Case-insensitive, so that no two gases differ only in capitals.
  name      String  @unique @db.Citext
  sortOrder Int     @map("sort_order")
  /// False once an admin retires the gas. A gas is never deleted.
  active    Boolean @default(true)

  @@map("gases")
}

/// A staff member who has signed in. The row outlives their account, so that
/// bills can go on showing who entered them. The admin role is not stored here;
/// the identity provider holds it.
model Staff {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId  String @unique @map("identity_id")
  displayName String @map("display_name")

  @@map("staff")
}

model Vehicle {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Case-insensitive, so that lists sort by plate whatever its capitals.
  plate  String  @db.Citext
  label  String?
  active Boolean @default(true)

  @@map("vehicles")
}
