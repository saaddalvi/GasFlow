# Copy to .env and adjust: cp .env.example .env
# The values below work with the Docker Compose database. They are for local
# development only; never put real secrets in this file.
# You must add the two Clerk keys to your .env.

# Host port for the Docker Compose Postgres.
POSTGRES_PORT=5433

# Database used by the API.
DATABASE_URL=postgresql://gasflow:gasflow@localhost:5433/gasflow

# Database used by the API tests. It is created if missing and EMPTIED before
# every test, so its name must end in _test.
TEST_DATABASE_URL=postgresql://gasflow:gasflow@localhost:5433/gasflow_test

# Address the API listens on.
API_HOST=127.0.0.1
API_PORT=4000

# Where the web app reaches the API.
API_URL=http://localhost:4000

# Port of the web app.
PORT=3000

# Clerk looks after staff accounts and sign-in. Copy both keys from the "API keys"
# page of the GasFlow application in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stops the web app creating a throwaway Clerk application when a key is missing.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true

# Optional. Comma-separated web app addresses, such as https://app.example.com.
# When set, the API accepts only sessions started there. Set it in production.
CLERK_AUTHORIZED_PARTIES=
